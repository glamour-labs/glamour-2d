{
  "schema": "glamour/v0.1",
  "canvas": {
    "w": 360,
    "h": 360,
    "bg": "#ffffff"
  },
  "groups": [
    { "id": "orbGroup", "x": 0, "y": 0 },
    { "id": "face", "x": 180, "y": 190 }
  ],
  "nodes": [
    { "id": "orb", "type": "circle", "x": 180, "y": 180, "r": 120, "fill": "#1cb0f6", "group": "orbGroup" },

    { "id": "eyeL", "type": "rect", "x": -28, "y": -16, "w": 14, "h": 28, "fill": "#ffffff", "group": "face" },
    { "id": "eyeR", "type": "rect", "x": 14, "y": -16, "w": 14, "h": 28, "fill": "#ffffff", "group": "face" },
    { "id": "mouth", "type": "rect", "x": -15, "y": 28, "w": 30, "h": 8, "fill": "#ffffff", "group": "face" },

    { "id": "checkBarA", "type": "rect", "x": 155, "y": 190, "w": 40, "h": 10, "fill": "#ffffff", "rotation": 45, "opacity": 0 },
    { "id": "checkBarB", "type": "rect", "x": 175, "y": 195, "w": 70, "h": 10, "fill": "#ffffff", "rotation": -45, "opacity": 0 },

    { "id": "star", "type": "rect", "x": 150, "y": 150, "w": 60, "h": 60, "fill": "#ffffff", "rotation": 45, "opacity": 0 },

    { "id": "heartL", "type": "circle", "x": 155, "y": 168, "r": 24, "fill": "#ffffff", "opacity": 0 },
    { "id": "heartR", "type": "circle", "x": 205, "y": 168, "r": 24, "fill": "#ffffff", "opacity": 0 },
    { "id": "heartBase", "type": "rect", "x": 180, "y": 165, "w": 50, "h": 50, "fill": "#ffffff", "rotation": 45, "opacity": 0 }
  ],
  "wander": [
    { "target": "face", "cx": 180, "cy": 190, "rx": 26, "ry": 16, "stepMs": 900, "ease": "easeInOut" }
  ],
  "machine": {
    "initial": "idle",
    "states": {
      "idle": {
        "set": {
          "orb.fill": "#1cb0f6",
          "eyeL.opacity": 1,
          "eyeR.opacity": 1,
          "mouth.opacity": 1,
          "checkBarA.opacity": 0,
          "checkBarB.opacity": 0,
          "star.opacity": 0,
          "heartL.opacity": 0,
          "heartR.opacity": 0,
          "heartBase.opacity": 0
        },
        "on": {
          "@SHOW_CHECK": "checked",
          "@SHOW_STAR": "star",
          "@SHOW_HEART": "heart",
          "@IDLE": "idle"
        }
      },
      "checked": {
        "set": {
          "orb.fill": "#34c759",
          "eyeL.opacity": 0,
          "eyeR.opacity": 0,
          "mouth.opacity": 0,
          "checkBarA.opacity": 1,
          "checkBarB.opacity": 1,
          "star.opacity": 0,
          "heartL.opacity": 0,
          "heartR.opacity": 0,
          "heartBase.opacity": 0
        },
        "on": {
          "@SHOW_CHECK": "checked",
          "@SHOW_STAR": "star",
          "@SHOW_HEART": "heart",
          "@IDLE": "idle"
        }
      },
      "star": {
        "set": {
          "orb.fill": "#ffc700",
          "eyeL.opacity": 0,
          "eyeR.opacity": 0,
          "mouth.opacity": 0,
          "checkBarA.opacity": 0,
          "checkBarB.opacity": 0,
          "star.opacity": 1,
          "heartL.opacity": 0,
          "heartR.opacity": 0,
          "heartBase.opacity": 0
        },
        "on": {
          "@SHOW_CHECK": "checked",
          "@SHOW_STAR": "star",
          "@SHOW_HEART": "heart",
          "@IDLE": "idle"
        }
      },
      "heart": {
        "set": {
          "orb.fill": "#ff4b4b",
          "eyeL.opacity": 0,
          "eyeR.opacity": 0,
          "mouth.opacity": 0,
          "checkBarA.opacity": 0,
          "checkBarB.opacity": 0,
          "star.opacity": 0,
          "heartL.opacity": 1,
          "heartR.opacity": 1,
          "heartBase.opacity": 1
        },
        "on": {
          "@SHOW_CHECK": "checked",
          "@SHOW_STAR": "star",
          "@SHOW_HEART": "heart",
          "@IDLE": "idle"
        }
      }
    },
    "transition": {
      "ms": 250,
      "ease": "easeOut"
    }
  }
}
