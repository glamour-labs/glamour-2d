    { "id": "title", "type": "text", "x": 30, "y": 30, "text": "Trace the a — follow the arrow", "size": 22, "fill": "#4b4b4b" },

    { "id": "ghostA", "type": "text", "x": 118, "y": 138, "text": "a", "size": 210, "fill": "#dcdedf" },

