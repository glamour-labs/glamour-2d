{
  "name": "@glamour-labs/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the glamour core operations as tools, so any MCP client can author .glam documents.",
  "keywords": ["glamour", "glam", "mcp", "model-context-protocol", "ai", "animation", "interactive"],
  "license": "MIT",
  "author": "Kha Vu",
  "homepage": "https://github.com/glamour-labs/glamour-2d#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glamour-labs/glamour-2d.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/glamour-labs/glamour-2d/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "glam-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@glamour-labs/core": "^0.1.0",
    "@glamour-labs/player": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsup": "^8.3.5"
  }
}
