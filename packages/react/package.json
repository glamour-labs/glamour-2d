{
  "name": "@glamour-labs/react",
  "version": "0.1.5",
  "description": "React binding for glamour documents — a <Glamour doc={…} /> component with an imperative handle for send/setInput/play/pause.",
  "keywords": ["glamour", "glam", "react", "animation", "interactive", "webgl", "canvas"],
  "license": "MIT",
  "author": "Kha Vu",
  "homepage": "https://github.com/glamour-labs/glamour-2d#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glamour-labs/glamour-2d.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/glamour-labs/glamour-2d/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@glamour-labs/core": "^0.1.8",
    "@glamour-labs/player": "^0.1.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
