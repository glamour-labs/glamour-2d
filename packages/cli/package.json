{
  "name": "@glamour-labs/cli",
  "version": "0.1.0",
  "description": "The glam CLI — new, validate, render, preview, and doctor for glamour documents.",
  "keywords": ["glamour", "glam", "cli", "animation", "interactive", "webgl", "canvas"],
  "license": "MIT",
  "author": "Kha Vu",
  "homepage": "https://github.com/glamour-labs/glamour-2d#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glamour-labs/glamour-2d.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/glamour-labs/glamour-2d/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "glam": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@glamour-labs/core": "^0.1.0",
    "@glamour-labs/player": "^0.1.0"
  },
  "peerDependencies": {
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsup": "^8.3.5",
    "@types/node": "^22.9.0"
  }
}
