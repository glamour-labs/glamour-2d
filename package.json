{
  "name": "glamour-2d",
  "private": true,
  "description": "An AI-native format and runtime for interactive, animated 2D canvases.",
  "license": "MIT",
  "author": "Kha Vu",
  "homepage": "https://github.com/glamour-labs/glamour-2d#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glamour-labs/glamour-2d.git"
  },
  "bugs": {
    "url": "https://github.com/glamour-labs/glamour-2d/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "skills/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "playground": "node scripts/serve.mjs",
    "release": "pnpm build && pnpm test && pnpm -r --filter \"./packages/*\" publish --access public"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/browser": "^2.1.4",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
